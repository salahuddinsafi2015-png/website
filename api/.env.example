APP_NAME="Lumen CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database: MySQL 8.0+ (production target)
#
# Automated tests run against an in-memory SQLite database for speed, but every
# migration is written with MySQL as the target. Verify schema changes against a
# real MySQL instance before deploying.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lumen_cms
DB_USERNAME=lumen
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# CMS
# ---------------------------------------------------------------------------

# Origin of the Next.js frontend, used for CORS on the API.
FRONTEND_URL=http://localhost:3000

CMS_SITE_NAME="Lumen CMS"
CMS_SITE_DESCRIPTION="A WordPress-style CMS powered by Laravel and Next.js."
CMS_POSTS_PER_PAGE=9
CMS_ALLOW_REGISTRATION=false
CMS_COMMENTS_ENABLED=true
CMS_COMMENTS_MODERATION=true
CMS_MEDIA_DISK=public
CMS_MEDIA_MAX_KB=5120

# Credentials created by the AdminUserSeeder. Change them before going live.
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=ChangeMe-2026!

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Production checklist — full walkthrough in docs/DEPLOYMENT.md
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.example.com
# FRONTEND_URL=https://www.example.com
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# CMS_BACKUP_KEEP=20
# SANCTUM_STATEFUL_DOMAINS=www.example.com
